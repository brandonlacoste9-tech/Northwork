# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — create a project at https://supabase.com/dashboard, then run
# supabase/schema.sql in the SQL editor. Find these values under
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key. Used only when the publishable key above is empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Session-pooler Postgres URI. Used by the Stripe webhook to record payment
# status. Leave blank to run the sample preview. Never commit a real URI.
DATABASE_URL=

# Stripe test mode (escrow via Connect). Leave blank until you are ready to
# charge test cards. Do not put live keys here.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional. When both are set, pitch, hire, message, and payment alerts are also emailed.
RESEND_API_KEY=
NOTIFICATION_FROM=
