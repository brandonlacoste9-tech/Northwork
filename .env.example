# Copy to .env.local and fill in. Never commit .env.local.

# Supabase — create a project at https://supabase.com/dashboard, then run
# supabase/schema.sql in the SQL editor. Find these values under
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key. Used only when the publishable key above is empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Session-pooler Postgres URI. Used by the Stripe webhook to record payment
# status. Leave blank to run the sample preview. Never commit a real URI.
DATABASE_URL=

# Stripe (escrow, Pro, and pitch tokens). Leave blank until you are ready.
# Do not put live keys in this file. The app uses existing prices only.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret for POST /api/webhooks/stripe. That route handles escrow
# events and Pro / pitch-token events. Register the URL in Stripe, then paste
# the signing secret here.
STRIPE_WEBHOOK_SECRET=

# Optional. When both are set, pitch, hire, message, payment, and saved-search
# alerts are also emailed. In-site alerts still work when these are empty.
RESEND_API_KEY=
NOTIFICATION_FROM=

# Bearer token for the morning digest: GET or POST /api/cron/job-alerts
# Authorization: Bearer <CRON_SECRET>. Call it once a day, around 8:00 America/Toronto.
CRON_SECRET=
